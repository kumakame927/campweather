{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then exit 1; else exit 0; fi",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/open-meteo/v1/forecast",
      "destination": "https://api.open-meteo.com/v1/forecast"
    },
    {
      "source": "/api/nominatim/search",
      "destination": "https://nominatim.openstreetmap.org/search"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
