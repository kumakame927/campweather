    "test:browser": "node tests/browser-preview.js",
    "test:network": "node tests/network-preview.cjs",
    "build:vercel": "VITE_API_TRANSPORT=same-origin vite build",
    "test:vercel": "node tests/vercel-preview.js",
    "test:trip": "node tests/trip-browser.js",
    "test:layout": "node tests/layout-browser.js",
    "test:jma": "node tests/jma-browser.js",
    "test:registration": "node tests/registration-browser.js",
    "test:pwa": "node tests/pwa-browser.js",
    "test:icons": "python tests/check-icons.py",
    "test:install": "node tests/installability-browser.js",
    "icons:build": "python scripts/build-icons.py",
    "catalog:update": "node scripts/update-camp-catalog.mjs",
    "test:library": "node tests/library-browser.js",
    "test:details": "node tests/details-browser.js"
